{
  "name": "@local/research-preset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Selects Research as the sole Agent preset in the research Web profile.",
  "exports": {
    ".": "./todo/projection.js",
    "./client": "./todo/client.js",
    "./todo-tool": "./todo/tool.js"
  },
  "files": [
    "cordis.patch.yml",
    "todo/*.js",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
