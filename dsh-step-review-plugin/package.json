{
  "name": "dsh-step-review-plugin",
  "description": "Pause after each agent step and prompt the user with predefined evaluation options before resuming.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown --config-loader native --config tsdown.config.ts",
    "prepare": "tsdown --config-loader native --config tsdown.config.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^4.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.16.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.16.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.0 <0.3.0",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
